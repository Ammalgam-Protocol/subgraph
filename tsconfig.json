{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", ".envio/types.d.ts"],
  "exclude": ["node_modules", "generated"]
}
